{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:phases": "tsx src/database/migrate-phase3-4.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:prod": "tsx src/database/seed-prod-init.ts",
    "db:seed:automakers": "tsx src/database/seed-automakers.ts",
    "db:seed:hw": "tsx src/database/seed-hw-catalogs.ts",
    "db:seed:hw:full": "tsx src/database/seed-hw-full-csv.ts",
    "db:seed:hw:dry-run": "tsx src/database/seed-hw-full-csv.ts --dry-run",
    "db:seed:hw2026": "tsx src/database/seed-hw-2026.ts",
    "db:seed:ar": "tsx src/database/seed-ar-catalog.ts",
    "db:seed:minigtbrasil": "tsx src/database/seed-minigtbrasil-catalog.ts",
    "db:seed:fandom": "tsx src/database/seed-fandom-catalog.ts",
    "db:seed:poprace": "tsx src/database/seed-poprace-catalog.ts",
    "db:seed:matchbox": "tsx src/database/seed-matchbox-catalog.ts",
    "db:seed:spark": "tsx src/database/seed-spark-catalog.ts",
    "db:seed:bburago": "tsx src/database/seed-bburago-catalog.ts"
  },

  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.9",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
